# Copy to .env (git-ignored). Names only; values stay on the machine or in CI secrets.

# Firebase project used by ./dev deploy and App Distribution
FIREBASE_PROJECT_ID=
FIREBASE_ANDROID_APP_ID=
FIREBASE_WEB_APP_ID=
# Firestore location for ./dev cloud firestore (default nam5)
FIRESTORE_LOCATION=
TESTER_GROUPS=testers

# Release signing (./dev apk release); the keystore lives outside the checkout
ANDROID_KEYSTORE_PATH=
ANDROID_KEY_ALIAS=
# ANDROID_KEYSTORE_PASSWORD and ANDROID_KEY_PASSWORD are read from the environment only

# Android SDK location when not ~/Android/Sdk
ANDROID_HOME=
