<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- to skip the cloud step when there is no network, so nothing is tried or counted as sent -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- speech is turned into text on the phone; audio is never recorded or sent -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- coarse only: matched to the nearest city on the phone, on request -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:name=".ContextLensApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ContextLens">
        <!-- Off until ContextLensApp turns it on (release builds with a built-in project), so a first launch sends nothing. -->
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="false" />
        <!-- Firebase is initialized in ContextLensApp, with the project the user connected in Settings. -->
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            tools:node="remove" />
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- contextlens://connect?…, opened from the site's connect page; it only fills in Settings. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="contextlens" android:host="connect" />
            </intent-filter>
        </activity>
    </application>
</manifest>
