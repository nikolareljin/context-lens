<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- to skip the cloud step when there is no network, so nothing is tried or counted as sent -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- speech is turned into text on the phone; audio is never recorded or sent -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- coarse only: matched to the nearest city on the phone, on request -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:name=".ContextLensApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ContextLens">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
